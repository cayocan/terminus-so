#!/bin/sh
# Quickshell não está nos repositórios do Debian: compila a partir do código-fonte
# e remove as dependências de compilação no final.
set -e

DEPS_BUILD="build-essential cmake ninja-build pkg-config spirv-tools \
	qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev \
	qt6-shadertools-dev qt6-wayland-dev qt6-wayland-private-dev \
	libwayland-dev wayland-protocols libdrm-dev libgbm-dev libegl-dev libvulkan-dev \
	libpipewire-0.3-dev libpam0g-dev libjemalloc-dev libcli11-dev libxcb1-dev \
	libpolkit-agent-1-dev libglib2.0-dev"

DEPS_RUNTIME="qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts \
	qml6-module-qtquick-shapes qml6-module-qtquick-particles qml6-module-qtquick-effects \
	qml6-module-qtquick-window qml6-module-qt-labs-folderlistmodel libqt6svg6 libjemalloc2"

# O Hyprland dos backports atualiza o libxkbcommon; os -dev precisam vir da mesma versão,
# senão o apt tenta rebaixar a biblioteca e a instalação falha.
DEPS_BUILD_BACKPORTS="libxkbcommon-dev libxkbcommon-x11-dev"

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y $DEPS_BUILD $DEPS_RUNTIME \
	$(for p in $DEPS_BUILD_BACKPORTS; do echo "$p/trixie-backports"; done)

# Versão fixa para a build não quebrar com mudanças no master; atualizar testando.
QUICKSHELL_VERSAO=v0.3.2

cd /tmp
git clone --depth 1 --branch "$QUICKSHELL_VERSAO" https://github.com/quickshell-mirror/quickshell.git
cd quickshell
# O crash handler precisa do cpptrace, que não está no Debian.
cmake -GNinja -B build \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DINSTALL_QML_PREFIX=lib/x86_64-linux-gnu/qt6/qml \
	-DDISTRIBUTOR="Terminus SO" \
	-DCRASH_HANDLER=OFF
# Cada compilação paralela pode passar de 1,5 GB de RAM; usa uma a cada 2 GB para não estourar a memória.
JOBS=$(awk '/MemTotal/ {print int($2 / 2097152)}' /proc/meminfo)
[ "$JOBS" -ge 1 ] || JOBS=1
cmake --build build -j "$JOBS"
cmake --install build

cd /
rm -rf /tmp/quickshell
apt-mark manual $DEPS_RUNTIME

# Marca como manuais as bibliotecas usadas pelo Quickshell compilado,
# para o autoremove não apagar nada que ele precise.
{ echo /usr/bin/quickshell; find /usr/lib -path '*qml/Quickshell*' -name '*.so'; } \
	| xargs -r ldd 2>/dev/null \
	| awk '/=> \// {print $3}' \
	| sort -u \
	| xargs -r dpkg -S 2>/dev/null \
	| cut -d: -f1 \
	| sort -u \
	| xargs -r apt-mark manual
DEBIAN_FRONTEND=noninteractive apt-get purge -y $DEPS_BUILD $DEPS_BUILD_BACKPORTS
apt-get autoremove -y
